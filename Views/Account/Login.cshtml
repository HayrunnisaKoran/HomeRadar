@{
    ViewBag.Title = "Giriş Yap";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-box-arrow-in-right"></i> @ViewBag.Title</h4>
            </div>
            <div class="card-body">
                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle"></i> @ViewBag.ErrorMessage
                    </div>
                }

                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" name="email" required />
                    </div>
                    
                    <div class="mb-3">
                        <label for="password" class="form-label">Şifre</label>
                        <input type="password" class="form-control" id="password" name="password" required />
                    </div>
                    
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-box-arrow-in-right"></i> Giriş Yap
                        </button>
                    </div>
                </form>

                <hr />
                <p class="text-center text-muted">
                    Hesabınız yok mu? 
                    <a asp-action="Register" class="text-primary">Kayıt Ol</a>
                </p>
                
                <hr />
                <p class="text-muted small">
                    <strong>Test Kullanıcıları:</strong><br />
                    Admin: admin@homeradar.com / admin123<br />
                    User: user@homeradar.com / user123
                </p>
            </div>
        </div>
    </div>
</div>

