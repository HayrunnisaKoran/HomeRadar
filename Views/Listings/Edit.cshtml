@model HomeRadar.Models.Listing

@{
    ViewBag.Title = "İlan Düzenle";
}

<h3><i class="bi bi-pencil"></i> @ViewBag.Title</h3>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="IsActive" />
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DistrictId" class="form-label">İlçe</label>
                    <select asp-for="DistrictId" class="form-select" asp-items="ViewBag.Districts">
                        <option value="">-- İlçe Seçin --</option>
                    </select>
                    <span asp-validation-for="DistrictId" class="text-danger"></span>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label asp-for="BuildingTypeId" class="form-label">Bina Tipi</label>
                    <select asp-for="BuildingTypeId" class="form-select" asp-items="ViewBag.BuildingTypes">
                        <option value="">-- Bina Tipi Seçin --</option>
                    </select>
                    <span asp-validation-for="BuildingTypeId" class="text-danger"></span>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Price" class="form-label">Fiyat (TL)</label>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label asp-for="SquareMeters" class="form-label">Metrekare (m²)</label>
                    <input asp-for="SquareMeters" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="SquareMeters" class="text-danger"></span>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="RoomCount" class="form-label">Oda Sayısı</label>
                    <input asp-for="RoomCount" class="form-control" type="number" />
                    <span asp-validation-for="RoomCount" class="text-danger"></span>
                </div>
                
                <div class="col-md-4 mb-3">
                    <label asp-for="SalonCount" class="form-label">Salon Sayısı</label>
                    <input asp-for="SalonCount" class="form-control" type="number" />
                    <span asp-validation-for="SalonCount" class="text-danger"></span>
                </div>
                
                <div class="col-md-4 mb-3">
                    <label asp-for="BuildingAge" class="form-label">Bina Yaşı</label>
                    <input asp-for="BuildingAge" class="form-control" type="number" />
                    <span asp-validation-for="BuildingAge" class="text-danger"></span>
                </div>
            </div>
            
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Kaydet
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> İptal
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

