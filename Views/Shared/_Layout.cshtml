<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - HomeRadar</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }
        .navbar {
            background-color: #333;
            color: white;
            padding: 15px;
        }
        .navbar a {
            color: white;
            text-decoration: none;
            margin-right: 20px;
        }
        .container {
            padding: 20px;
        }
        footer {
            background-color: #333;
            color: white;
            text-align: center;
            padding: 10px;
            position: fixed;
            bottom: 0;
            width: 100%;
        }
    </style>
</head>
<body>
    <div class="navbar">
        <a href="@Url.Action("Index", "Home")">Ana Sayfa</a>
        <a href="@Url.Action("About", "Home")">Hakkında</a>
        <a href="@Url.Action("Contact", "Home")">İletişim</a>
    </div>
    
    <div class="container">
        @RenderBody()
    </div>
    
    <footer>
        <p>&copy; @DateTime.Now.Year - HomeRadar - Emlak Değerleme Sistemi</p>
    </footer>
</body>
</html>

