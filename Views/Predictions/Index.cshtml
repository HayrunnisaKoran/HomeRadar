@model IEnumerable<HomeRadar.Models.Prediction>

@{
    ViewBag.Title = "Tahmin Geçmişi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="bi bi-graph-up"></i> Tahminler</h3>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Yeni Tahmin Oluştur
    </a>
</div>

@* ViewBag ile istatistikler *@
<div class="row mb-3">
    <div class="col-md-6">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h6>Toplam Tahmin</h6>
                <h3>@ViewBag.TotalPredictions</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h6>Ortalama Fiyat</h6>
                <h3>@(((decimal)(ViewBag.AvgPrice ?? 0)).ToString("C0"))</h3>
            </div>
        </div>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Kullanıcı</th>
                    <th>İlçe</th>
                    <th>Oda</th>
                    <th>m²</th>
                    <th>Fiyat Aralığı</th>
                    <th>Tarih</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@(item.User != null ? $"{item.User.FirstName} {item.User.LastName}" : "Misafir")</td>
                        <td>@(item.District?.Name ?? "Bilinmiyor")</td>
                        <td>@item.RoomCount</td>
                        <td>@item.SquareMeters m²</td>
                        <td>@item.PredictedPriceMin.ToString("C0") - @item.PredictedPriceMax.ToString("C0")</td>
                        <td>@item.CreatedAt.ToString("dd.MM.yyyy")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i>
                            </a>
                            @if (ViewContext.HttpContext.Session.GetString("UserRole") == "Admin")
                            {
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Henüz tahmin bulunmamaktadır.
    </div>
}

