@model HomeRadar.Models.Prediction

@{
    ViewBag.Title = "Yeni Tahmin Oluştur";
}

<h3><i class="bi bi-plus-circle"></i> @ViewBag.Title</h3>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DistrictId" class="form-label">İlçe</label>
                    <select asp-for="DistrictId" class="form-select" asp-items="ViewBag.Districts">
                        <option value="">-- İlçe Seçin --</option>
                    </select>
                    <span asp-validation-for="DistrictId" class="text-danger"></span>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label asp-for="BuildingTypeId" class="form-label">Bina Tipi</label>
                    <select asp-for="BuildingTypeId" class="form-select" asp-items="ViewBag.BuildingTypes">
                        <option value="">-- Bina Tipi Seçin (Opsiyonel) --</option>
                    </select>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="RoomCount" class="form-label">Oda Sayısı</label>
                    <input asp-for="RoomCount" class="form-control" type="number" />
                    <span asp-validation-for="RoomCount" class="text-danger"></span>
                </div>
                
                <div class="col-md-4 mb-3">
                    <label asp-for="SquareMeters" class="form-label">Metrekare (m²)</label>
                    <input asp-for="SquareMeters" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="SquareMeters" class="text-danger"></span>
                </div>
                
                <div class="col-md-4 mb-3">
                    <label asp-for="BuildingAge" class="form-label">Bina Yaşı</label>
                    <input asp-for="BuildingAge" class="form-control" type="number" />
                    <span asp-validation-for="BuildingAge" class="text-danger"></span>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="PredictedPriceMin" class="form-label">Min Fiyat (TL)</label>
                    <input asp-for="PredictedPriceMin" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="PredictedPriceMin" class="text-danger"></span>
                </div>
                
                <div class="col-md-4 mb-3">
                    <label asp-for="PredictedPriceMax" class="form-label">Max Fiyat (TL)</label>
                    <input asp-for="PredictedPriceMax" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="PredictedPriceMax" class="text-danger"></span>
                </div>
                
                <div class="col-md-4 mb-3">
                    <label asp-for="ModelName" class="form-label">Model Adı</label>
                    <input asp-for="ModelName" class="form-control" placeholder="Örn: LinearRegression" />
                </div>
            </div>
            
            <div class="mb-3">
                <label asp-for="UserId" class="form-label">Kullanıcı (Opsiyonel)</label>
                <select asp-for="UserId" class="form-select" asp-items="ViewBag.Users">
                    <option value="">-- Kullanıcı Seçin (Opsiyonel) --</option>
                </select>
            </div>
            
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Kaydet
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Geri Dön
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

