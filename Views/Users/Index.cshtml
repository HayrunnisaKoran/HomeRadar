@model IEnumerable<HomeRadar.Models.User>

@{
    ViewBag.Title = "Kullanıcı Yönetimi";
    // Sadece Admin görebilir - Controller'da [AuthorizeRole("Admin")] var
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="bi bi-people"></i> Kullanıcılar</h3>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus"></i> Yeni Kullanıcı Ekle
    </a>
</div>

@* ViewBag ile istatistikler *@
<div class="row mb-3">
    <div class="col-md-4">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h6>Toplam Kullanıcı</h6>
                <h3>@ViewBag.TotalUsers</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h6>Admin Sayısı</h6>
                <h3>@ViewBag.AdminCount</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <h6>User Sayısı</h6>
                <h3>@ViewBag.UserCount</h3>
            </div>
        </div>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Ad Soyad</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.FirstName @item.LastName</td>
                        <td>@item.Email</td>
                        <td>
                            @if (item.Role == "Admin")
                            {
                                <span class="badge bg-danger">Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">User</span>
                            }
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pasif</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Henüz kullanıcı bulunmamaktadır.
    </div>
}

