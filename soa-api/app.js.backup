// 📌 5. FİYAT TAHMİNİ (PROJENİN KALBİ!)
app.post('/api/predict', (req, res) => {
  console.log('🔍 Tahmin İsteği:', req.body);
  
  const { district, rooms, squareMeters, buildingAge } = req.body;
  
  // Validasyon
  if (!district || !rooms || !squareMeters || !buildingAge) {
    return res.status(400).json({
      success: false,
      error: 'Eksik parametre! district, rooms, squareMeters, buildingAge gerekiyor.'
    });
  }
  
  // İlçe katsayıları
  const districtRates = {
    'yunusemre': 1.3,
    'şehzadeler': 1.2,
    'akhisar': 1.0,
    'turgutlu': 0.9,
    'salihli': 0.85
  };
  
  // Oda katsayıları
  const roomRates = {
    '1+1': 0.8,
    '2+1': 1.0,
    '3+1': 1.4,
    '4+1': 1.8
  };
  
  // Hesaplama
  const districtKey = district.toLowerCase();
  const districtFactor = districtRates[districtKey] || 1.0;
  const roomFactor = roomRates[rooms] || 1.0;
  const ageFactor = Math.max(0.7, 1 - (buildingAge * 0.015));
  const sizeFactor = squareMeters / 80;
  
  const basePrice = 7500; // Manisa baz fiyatı
  const estimated = basePrice * districtFactor * roomFactor * ageFactor * sizeFactor;
  
  // Sonuç
  res.json({
    success: true,
    input: { district, rooms, squareMeters, buildingAge },
    prediction: {
      minPrice: Math.round(estimated * 0.88),
      maxPrice: Math.round(estimated * 1.12),
      averagePrice: Math.round(estimated),
      currency: 'TRY',
      confidence: 0.82
    },
    calculationDetails: {
      formula: 'basePrice * district * rooms * age * size',
      basePrice: basePrice,
      factors: {
        district: districtFactor,
        rooms: roomFactor,
        age: ageFactor,
        size: sizeFactor
      }
    },
    note: 'Mock hesaplama kullanıldı. Gerçek ML modeli entegrasyonu yapılacak.'
  });
});

