// ==================== gRPC INTEGRATION ====================
const grpc = require('@grpc/grpc-js');
const protoLoader = require('@grpc/proto-loader');
const path = require('path');

// 1. Proto dosyasını yükle
const PROTO_PATH = path.join(__dirname, 'grpc-server/protos/prediction.proto');
const packageDefinition = protoLoader.loadSync(PROTO_PATH);
const predictionProto = grpc.loadPackageDefinition(packageDefinition).smartvalue;

// 2. gRPC Client oluştur
const grpcClient = new predictionProto.PredictionService(
  'localhost:50051',  // gRPC Server adresi
  grpc.credentials.createInsecure()
);

console.log('✅ gRPC Client hazır. Server: localhost:50051');

// 3. YENİ ENDPOINT: gRPC ile tahmin yap
app.post('/api/predict-grpc', (req, res) => {
  console.log('📡 gRPC isteği alındı:', req.body);
  
  const { district, rooms, squareMeters, buildingAge } = req.body;
  
  // Validasyon
  if (!district || !rooms || !squareMeters || !buildingAge) {
    return res.status(400).json({
      success: false,
      error: 'Eksik parametre!'
    });
  }
  
  // gRPC formatına çevir
  const grpcRequest = {
    district: district,
    rooms: rooms,
    square_meters: squareMeters,
    building_age: buildingAge
  };
  
  console.log('➡️ gRPC Request:', grpcRequest);
  
  // gRPC çağrısı yap
  grpcClient.Predict(grpcRequest, (error, response) => {
    if (error) {
      console.error('❌ gRPC Hatası:', error);
      
      // Fallback: Normal REST kullan
      const estimated = squareMeters * 130;
      res.json({
        success: true,
        source: 'REST-Fallback (gRPC failed)',
        prediction: {
          minPrice: Math.round(estimated * 0.9),
          maxPrice: Math.round(estimated * 1.1),
          confidence: 0.7
        }
      });
      
    } else {
      console.log('✅ gRPC Yanıtı:', response);
      
      // gRPC başarılı
      res.json({
        success: true,
        source: 'gRPC-ML-Service',
        protocol: 'gRPC',
        prediction: {
          minPrice: response.min_price,
          maxPrice: response.max_price,
          confidence: response.confidence,
          modelVersion: response.model_version || 'v1.0'
        },
        note: 'Mock gRPC server kullanıldı. Python ML hazır olunca değişecek.'
      });
    }
  });
});

// 4. gRPC durumunu kontrol endpoint'i
app.get('/api/grpc-status', (req, res) => {
  res.json({
    gRPC: {
      server: 'localhost:50051',
      status: 'connected',
