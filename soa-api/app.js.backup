    }
  });
});
// ==================== gRPC SONU ====================

// ==================== SOAP INTEGRATION ====================
const SoapCurrencyClient = require('./services/soapClient');

const soapClient = new SoapCurrencyClient();

// 1. DÖVİZ KURU ENDPOINT
app.get('/api/currency', async (req, res) => {
  try {
    console.log('💰 SOAP/Döviz isteği alındı');
    
    const rates = await soapClient.getExchangeRates();
    
    res.json({
      success: true,
      protocol: 'SOAP/XML Simulation',
      note: 'TCMB SOAP servisi simulasyonu. Gerçek SOAP WSDL kullanılabilir.',
      ...rates
    });
    
  } catch (error) {
    console.error('SOAP Error:', error);
    res.status(500).json({
      success: false,
      error: 'SOAP service error',
      message: error.message
    });
  }
});

// 2. EMLAK FİYATINI DÖVİZE ÇEVİR
app.get('/api/currency/convert', async (req, res) => {
  try {
    const { price, currency = 'USD' } = req.query;
    
    if (!price) {
      return res.status(400).json({
        success: false,
        error: 'Price parameter required'
      });
    }
    
    const priceNum = parseFloat(price);
    const conversion = await soapClient.convertPropertyPrice(priceNum, currency.toUpperCase());
    
    res.json({
      success: true,
      protocol: 'SOAP',
      ...conversion
    });
    
  } catch (error) {
    res.status(500).json({ error: 'Conversion failed' });
  }
});

// 3. SOAP DURUMU
app.get('/api/soap-status', (req, res) => {
  res.json({
    soap: {
      service: 'Currency Exchange Service',
      type: 'SOAP/XML Simulation',
      status: 'active',
      endpoints: {
        rates: '/api/currency',
        convert: '/api/currency/convert?price=10000&currency=USD'
      },
      note: 'Mock SOAP service for demonstration. Real SOAP would use WSDL.'
    }
  });
});
// ==================== SOAP SONU ====================

// ==================== GOOGLE MAPS INTEGRATION ====================
const googleMapsService = require('./services/googleMapsService');

// 1. Google Maps ile koordinat al
app.get('/api/maps/coordinates', async (req, res) => {
    try {
        const { address } = req.query;
        
        if (!address) {
            return res.status(400).json({
                success: false,
                error: 'Address parameter required (örn: ?address=Yunusemre,Manisa)'
            });
        }
        
        const coordinates = await googleMapsService.getCoordinates(address);
        
        res.json({
            success: true,
            protocol: 'Google Maps Geocoding API',
            ...coordinates
        });
        
    } catch (error) {
        res.status(500).json({ error: error.message });
    }
});

// 2. Tüm ilçelerin koordinatlarını getir
app.get('/api/maps/districts', async (req, res) => {
    try {
        const districts = await googleMapsService.getAllDistrictsCoordinates();
        
        res.json({
            success: true,
            source: 'Google Maps API',
            count: districts.length,
            districts: districts
        });
        
    } catch (error) {
        res.status(500).json({ error: error.message });
    }
});

// 3. Google Maps durumu
app.get('/api/maps-status', (req, res) => {
    res.json({
        google_maps: {
            service: 'Geocoding API',
            status: 'active',
            api_key: process.env.GOOGLE_MAPS_API_KEY ? 'configured' : 'not configured',
            endpoints: {
                coordinates: '/api/maps/coordinates?address=Yunusemre,Manisa',
                districts: '/api/maps/districts',
                test: 'https://maps.googleapis.com/maps/api/geocode/json?address=Manisa,Turkey&key=YOUR_KEY'
            },
            note: 'Google Maps API successfully integrated with billing account'
        }
    });
});
// ==================== GOOGLE MAPS SONU ====================

